# =============================================================================
# AI Daily News - Environment Variables Template
# Copy to `.env` and edit; never commit the real .env
# =============================================================================

# ----- LLM (Anthropic-compatible) Required -----
# Anthropic API key (or compatible gateway: OneAPI/DeepSeek/Moonshot)
AIDAILY_LLM_API_KEY=sk-ant-...

# LLM endpoint base URL (default: official Anthropic)
AIDAILY_LLM_BASE_URL=https://api.anthropic.com

# LLM model name (default: claude-haiku-4-5)
AIDAILY_LLM_MODEL=claude-haiku-4-5-20251001

# Daily LLM budget cap in USD; on exceed, business code 9002 raised
AIDAILY_LLM_DAILY_BUDGET_USD=2.00

# ----- Auth (Optional; auto-generated if missing) -----
# Static Bearer token for write endpoints. If unset, a random one is generated
# and printed to stdout once at startup.
AIDAILY_BEARER_TOKEN=

# ----- Server -----
AIDAILY_HOST=127.0.0.1
AIDAILY_PORT=8000
AIDAILY_TZ=Asia/Shanghai

# ----- Database -----
# SQLite file path (relative to backend/ or absolute)
AIDAILY_DB_PATH=./data/aidaily.db

# ----- Scheduler -----
# Default daily push time (HH:mm 24h, Asia/Shanghai); overridable via PUT /settings
AIDAILY_DAILY_PUSH_TIME=08:00

# ----- X (Twitter) via twitter-cli (Optional) -----
# X source shells out to a local `twitter` CLI (twitter user-posts --json).
# Auth, pick one:
#   a) Explicit cookies from x.com (both required)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
#   b) Reuse local browser x.com login (Windows DPAPI; Chrome/Arc/Edge/Firefox/Brave)
AIDAILY_X_ALLOW_BROWSER_COOKIES=
# Path to the `twitter` executable (default: PATH lookup + Windows pip --user dir)
AIDAILY_TWITTER_BIN=
# When neither auth works, the X source is silently skipped.

# Comma-separated list of X account usernames (overrides default 28-KOL list)
# Default list in backend/app/pipeline/defaults/x_accounts.py
AIDAILY_X_ACCOUNTS=karpathy,ylecun,simonw,swyx

# ----- GitHub (Optional) -----
# PAT for higher rate limit; if empty, falls back to trending HTML scrape
AIDAILY_GITHUB_TOKEN=

# ----- Reddit (Required for Reddit source) -----
# Reddit API user-agent string
AIDAILY_REDDIT_UA=ai-daily/1.0 by your_username
